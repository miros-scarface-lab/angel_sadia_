# Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model preference (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Port for local server (default: 3000)
PORT=3000

# Permanent Google Sheets Chat Logging (Paste your deployed Web App URL here)
# See google-sheet-script.js for the 1-minute setup guide
GOOGLE_SHEET_WEBHOOK_URL=

# Optional alternative logging
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
